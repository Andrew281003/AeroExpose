<Window x:Class="AeroExpose.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroExpose Settings" Width="940" Height="680" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#111318" Foreground="#F3F5F8"
        FontFamily="{StaticResource AppFont}" Closing="OnClosing">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,7"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinWidth" Value="190"/><Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="0,6"/><Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,8"/><Setter Property="Height" Value="26"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,7,8,7"/>
      <Setter Property="Background" Value="#2A6EDB"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.Column="0" Background="#191C23" BorderBrush="#2A2E38" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,20">
          <TextBlock Text="AeroExpose" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Settings" Foreground="#8E97A8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Foreground="#E8EBF1"
                 FontSize="14" SelectionChanged="OnNavigationChanged">
          <ListBox.Resources>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.Resources>
          <ListBoxItem Content="General"/><ListBoxItem Content="Appearance"/><ListBoxItem Content="Animations"/>
          <ListBoxItem Content="Input"/><ListBoxItem Content="Windows"/><ListBoxItem Content="Advanced"/>
          <ListBoxItem Content="About"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,26,34,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Margin="0,0,16,20"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
